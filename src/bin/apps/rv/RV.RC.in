IDI_ICON1 ICON DISCARDABLE "@RV_ICON_PATH@"

#include <windows.h>

#ifndef DEBUG
#define VER_DEBUG 0
#else
#define VER_DEBUG VS_FF_DEBUG
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @RV_MAJOR_VERSION@,@RV_MINOR_VERSION@,@RV_REVISION_NUMBER@,0
PRODUCTVERSION @RV_MAJOR_VERSION@,@RV_MINOR_VERSION@,@RV_REVISION_NUMBER@,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      VER_DEBUG
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@RV_INTERNAL_ORGANIZATION_NAME@\0"
            VALUE "FileDescription",  "@RV_UI_APPLICATION_NAME@ Professional Image and Sequence Player\0"
            VALUE "FileVersion",      "@RV_MAJOR_VERSION@.@RV_MINOR_VERSION@.@RV_REVISION_NUMBER@.0\0"
            VALUE "InternalName",     "@RV_INTERNAL_APPLICATION_NAME@\0"
            VALUE "LegalCopyright",   "Copyright (C) @RV_VERSION_YEAR@ OpenUTV Contributors. Portions Copyright 2022-2023 Autodesk, Inc., and 2001-2022 Tweak Software.\0"
            VALUE "OriginalFilename", "utv.exe\0"
            VALUE "ProductName",      "@RV_UI_APPLICATION_NAME@\0"
            VALUE "ProductVersion",   "@RV_MAJOR_VERSION@.@RV_MINOR_VERSION@.@RV_REVISION_NUMBER@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
